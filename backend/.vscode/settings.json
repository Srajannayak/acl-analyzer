{
    "files.exclude": {
        "**/venv": true,
        "**/.venv": true,
        "**/node_modules": true,
        "**/__pycache__": true,
        "**/*.pyc": true
    },

    "search.exclude": {
        "**/venv": true,
        "**/.venv": true,
        "**/node_modules": true,
        "**/__pycache__": true,
        "**/*.pyc": true
    },

    "files.watcherExclude": {
        "**/venv/**": true,
        "**/.venv/**": true,
        "**/node_modules/**": true,
        "**/__pycache__/**": true
    }
}